# Configuración de Caddy.
# Al poner un dominio, Caddy pide solo el certificado HTTPS a Let's Encrypt, lo renueva antes de que
# caduque y redirige http:// a https:// sin que tengamos que hacer nada más.

peatying.com {
	# Las peticiones a la API son una pregunta de 3000 caracteres como mucho: cualquier cosa más grande
	# es un abuso (subir megas para agotar la memoria). Se corta aquí, antes de llegar a la app.
	# La excepción es adjuntar un documento (PDF o foto de hasta 5 MB; la app vuelve a comprobarlo).
	@small not path /api/document
	request_body @small {
		max_size 16KB
	}
	request_body /api/document {
		max_size 6MB
	}
	# HTTPS obligatorio durante un año: el navegador no volverá a intentar http:// con este dominio.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8080 {
		# Respuestas en streaming (SSE): mandar cada trozo al navegador en cuanto llega, sin acumular.
		flush_interval -1
	}
}

# www.peatying.com lleva a la dirección principal (301 = redirección permanente). También con http://, de un
# solo salto: si no, Caddy primero pasaría a https://www y de ahí a https://peatying.com.
www.peatying.com, http://www.peatying.com {
	redir https://peatying.com{uri} permanent
}
